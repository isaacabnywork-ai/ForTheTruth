# WordPress / WooCommerce
# Public URL is safe to expose (used for image domains, links)
NEXT_PUBLIC_WORDPRESS_URL=https://your-wordpress-site.com

# SERVER-SIDE ONLY — never prefix these with NEXT_PUBLIC_
WOOCOMMERCE_API_KEY=ck_xxxxxxxxxxxx
WOOCOMMERCE_API_SECRET=cs_xxxxxxxxxxxx

# Auth.js (Phase 3)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32

# Admin access — comma-separated emails allowed into /admin (must match WP accounts)
ADMIN_EMAILS=you@example.com

# Razorpay (Phase 4) — only the key ID is public
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxx
